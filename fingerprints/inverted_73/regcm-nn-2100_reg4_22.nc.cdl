POT:_FillValue = -1.f ;
POT:long_name = "Exceedance frequency" ;
POT:coordinates = "lon lat" ;
POT:valid_timesteps = 258480 ;
POT:region = 4 ;
POT:simulation = 22 ;
POT:mask_value = 5 ;
POT:period_name = 2100 ;
POT:ref_period_name = 2005. ;
